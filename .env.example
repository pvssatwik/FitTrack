# --- API / worker ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flb:flb@localhost:5432/flb
SESSION_SECRET=change-me
# 32-byte key (base64) used to encrypt provider tokens at rest (phase 2, API route)
TOKEN_ENCRYPTION_KEY=

# --- Object storage (Cloudflare R2, S3-compatible). Optional: raw files may be deleted after parsing ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=524288000

# --- Provider OAuth (phase 2) ---
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
ULTRAHUMAN_CLIENT_ID=
ULTRAHUMAN_CLIENT_SECRET=
