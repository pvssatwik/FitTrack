{
  "name": "@flb/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --noExternal @flb/shared --noExternal @flb/parsers --noExternal @flb/scoring",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@flb/parsers": "*",
    "@flb/scoring": "*",
    "@flb/shared": "*",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
