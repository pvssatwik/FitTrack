{
  "name": "@flb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --noExternal @flb/shared --noExternal @flb/parsers --noExternal @flb/scoring",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@flb/parsers": "*",
    "@flb/scoring": "*",
    "@flb/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
